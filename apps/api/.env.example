# Requires a local MongoDB running as a single-node replica set (see prisma/HOST_MONGO_SETUP.md)
DATABASE_URL="mongodb://127.0.0.1:27017/clinic_care?replicaSet=rs0"
PORT=4100
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Comma-separated list of allowed web app origins, only needed when the web app is
# deployed separately from the API (e.g. Vercel + Render). Not needed for local dev
# (localhost is always allowed) or the same-origin single-deployment setup.
# FRONTEND_URL="https://your-app.vercel.app"
